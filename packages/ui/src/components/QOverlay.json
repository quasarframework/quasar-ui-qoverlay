{
  "meta": {
    "docsUrl": "https://quasarframework.github.io/quasar-ui-qoverlay"
  },

  "props": {
    "model-value": {
      "category": "model",
      "type": "Boolean",
      "desc": "Model of the component defining 'active' state. Either use this property (along with a listener for 'update:model-value' event) OR use v-model directive"
    },
    "opacity": {
      "type": [ "Number", "String" ],
      "tsType": "number | string",
      "category": "style",
      "desc": "Used to change the opacity of the overlay",
      "default": "0.35",
      "examples": ["0.50"]
    },
    "background-color": {
      "type": "String",
      "category": "style",
      "desc": "Used to change the background color of the overlay. Removes alpha channel to use opacity property.",
      "default": "#000000",
      "examples": ["#FFF", "rgba(255, 0, 255, 0.5)"]
    },
    "z-index": {
      "type": [ "Number", "String" ],
      "tsType": "number | string",
      "category": "behavior",
      "desc": "Used to change the z-index of the overlay",
      "default": "6000",
      "examples": [ "5000" ]
    },
    "cursor-type": {
      "type": "String",
      "tsType": "OverlayCursorType",
      "category": "behavior",
      "desc": "Used to change the cursor type of the overlay. Any valid cursor type is allowed except for `url`",
      "default": "not-allowed",
      "values": [
        "alias",
        "all-scroll",
        "auto",
        "cell",
        "context-menu",
        "col-resize",
        "copy",
        "crosshair",
        "default",
        "e-resize",
        "ew-resize",
        "grab",
        "grabbing",
        "help",
        "move",
        "n-resize",
        "ne-resize",
        "nesw-resize",
        "no-drop",
        "none",
        "not-allowed",
        "pointer",
        "progress",
        "row-resize",
        "s-resize",
        "nontext",
        "w-resize",
        "wait",
        "zoom-in",
        "zoom-out",
        "inherit"
      ],
      "examples": [ "pointer", "wait" ]
    },
    "no-scroll": {
      "type": "Boolean",
      "category": "behavior",
      "desc": "Used to turn off scrollbars"
    }
  },
  "slots": {
    "default": {
      "desc": "Anything can go into this slot"
    },
    "body": {
      "desc": "Anything using the body slot will be placed above the overlay (ex: QBtn)"
    }
  }
}
